# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/redstring
# Cloud:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/redstring?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/redstring

# Long random string used to sign login tokens. REQUIRED in production.
JWT_SECRET=change-me-to-a-long-random-string

# Only needed if the frontend is hosted on a different domain than the API.
# FRONTEND_URL=http://localhost:5173

# Optional: use OpenAI to write generated cases.
# OPENAI_API_KEY=sk-...

# Password / username recovery emails (Brevo, free 300/day): https://app.brevo.com
# BREVO_API_KEY=xkeysib-...
# MAIL_FROM=your-verified-sender@gmail.com
# MAIL_FROM_NAME=RED STRING
# Public URL used in emailed links (defaults to the live Render URL)
# APP_URL=https://red-string-7n2s.onrender.com
